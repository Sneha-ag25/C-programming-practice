//Write a program to find the substring of a given string.
#include<stdio.h> 
#include<string.h> 
int main() 
{char str[100], sub[100];
 int i,j=0,x,y;
 printf("Enter a sentence:\n");
 fgets(str, 100, stdin);
 printf("Enter the start and end index for the substring\n");
 scanf("%d%d",&x,&y);
 for(i=x;i<=y;i++)
    {sub[j]=str[i];
     j++;
    }
 printf("The substring is\n%s",sub);
 return 0;
} 
