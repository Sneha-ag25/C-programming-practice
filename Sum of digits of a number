//Write a program to find sum of the digits of a four digit number
#include<stdio.h>
int main()
{
 int num,sum=0;
 printf("Enter a 4-digit number\n");
 scanf("%d",&num);
  sum+=num%10;
  num/=10; sum+=num%10;
  num/=10; sum+=num%10;
  num/=10; sum+=num%10;
 printf("The sum of the digits=%d",sum);
 return 0;
}
