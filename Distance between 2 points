//Write a program to find out the distance between two points.
#include<stdio.h> 
#include<math.h>
int main()
{
 float x1,x2,y1,y2,distance;
 printf("Enter co-ordinates of the two points\n");
 scanf("%f%f%f%f",&x1,&y1,&x2,&y2);
 printf("Distance between the two points=%f\n",distance=sqrt((x2-x1)*(x2-x1)+(y2-y1)*(y2-y1)));
 return 0;
}
