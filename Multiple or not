//Write a program that takes 2 numbers as input and finds whether one number is multiple of other or not.
#include <stdio.h>
#include <math.h>
int main() 
{ double a,b;
  printf("Enter two numbers\n");
  scanf("%lf %lf",&a,&b);
  if (fmod(a,b)==0)
     printf("\n%2.1lf is a multiple of %2.1lf", a, b);
  else if (fmod(b,a)==0)
    printf("\n%2.1lf is a multiple of %2.1lf", b, a);
  else
    printf("Neither number is multiple of each other");
    return 0;
}
