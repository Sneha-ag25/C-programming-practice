//Write a program to check whether a number is prime or not
#include<stdio.h>
int main()
{
int num,i,isPrime;
printf("Enter the number to check prime\n");
scanf("%d",&num);
 if (num<=1)
    isPrime=0;
 else
    { for (i=2;i<num;i++)
      {if (num%i==0)
          {isPrime=0;
           break;}
      }
    }
if (isPrime==0)
   printf("%d is not prime number",num);
else 
   printf("%d is a prime number",num);
return 0;
}
