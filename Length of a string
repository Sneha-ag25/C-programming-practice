//Write a program to find the string length of a string without using the predefined function
#include<stdio.h> 
#include<string.h> 
int main() 
{char str[100];
 int count=0, i;
 printf("Enter a sentence:\n");
 fgets(str, 100, stdin);
 for(i=0;str[i]!='\0';i++)
    {count++;}
 if (str[count-1]=='\n')
   count--;
 printf("The total number of characters is: %d", count);
 return 0;
} 
