//Write a programs to tell which day of the week it is according to the number of days 
#include<stdio.h> 
int main()
{
int day; 
printf("enter number of week days\n");
scanf("%d", &day);
switch (day)
{
case 1: printf("monday \n");
break;
case 2: printf("tuesday \n");
break;
case 3: printf("wednesday \n");
break;
case 4: printf("thursday \n");
break;
case 5: printf("friday \n");
break;
case 6: printf("saturday \n");
break;
case 7: printf("sunday \n");
break;
default: printf("invalid choice");
}
return 0;
}
