//Write a program to find the GCD of two numbers recursively. (Ex: GCD of 9, 24 is 3)
#include <stdio.h>
int gcd(int a, int b)
{
    if (b == 0)
        return a;       
    else
        return gcd(b, a % b);   
}
int main()
{
    int x, y;
    printf("Enter two integers:\n");
    scanf("%d %d", &x, &y);
    int result = gcd(x, y);
    printf("GCD of %d and %d is %d\n", x, y, result);
    return 0;
}
