//Write a program to covert time in seconds to time in minutes and seconds
#include<stdio.h> 
int main()
{
float sec, min, hrs; 
printf("enter time in seconds\n");
scanf("%f", &sec);
min=sec/60;
hrs=sec/3600;
printf("The time in seconds is %f\n time in minutes is %f\n and the time in hours is %f\n", sec, min, hrs);
return 0;
}
