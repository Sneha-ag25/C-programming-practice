//Write a program to covert time in seconds to time in minutes and seconds
#include<stdio.h> 
int main()
{
float sec, min, hrs; 
printf("Enter time in seconds\n");
scanf("%f", &sec);
printf("Time in seconds is %f\nTime in minutes is %f\nTime in hours is %f\n", sec, min=sec/60,
hrs=sec/3600);
return 0;
}
