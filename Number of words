//Write a program to count the number of words in a sentence.
#include<stdio.h> 
#include<string.h> 
int main() 
{ int count=1, i;
  char sent[100];
  printf("Enter a sentence:\n");
  fgets(sent, 100, stdin);
  for (i=0;sent[i]!='\0';i++)
     {if (sent[i]==' ')
         {count++;}
     }
  printf("Total number of words= %d",count);
  return 0;
}
