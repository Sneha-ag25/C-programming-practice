//Write a program to take 3 student marks in 5 subjects. Print the total marks of each student and the average marks of each subject.
#include<stdio.h> 
int main() 
{
int i,j,marks[3][5]; 
 printf("Enter the marks of 3 students in 5 subjects\n");
 for(i=0;i<3;i++)
    {for(j = 0; j < 5; j++) {
     scanf("%d", &marks[i][j]);}
    }
 for(i=0;i<3;i++)
    {int total=0;
     for(j = 0; j < 5; j++) {
    total+=marks[i][j];}
    printf("Total marks of %d student is = %d\n", i+1, total);
    }
 for(j=0; j<5; j++)
    {float avg=0;
     for (i=0;i<3;i++){
    avg+=marks[i][j];}
    avg=avg/3;
    printf("Average marks in %d subject is = %.2f\n", j+1, avg);
    }
 return 0; 
}
