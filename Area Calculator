//Write a program to calculate area of different 2-D shapes
#include <stdio.h>
int main() 
{int choice;
 float area;
 char repeat;
do{
printf("                *Area Calculator*\n");
printf("Choose a shape:\n");
printf("1 Circle\n2 Triangle\n3 Rectangle\n4 Square\n5 Parallelogram\n6 Kite\n7 Rhombus\n8 Trapezium\n");
printf("Enter your choice:");
scanf("%d",&choice);
switch(choice)
 {
  case 1:
    {float r;
    printf("Enter the radius of the Circle:");
    scanf("%f",&r);
    printf("Area of Circle= %.2f",area=3.14159*r*r);
    break;}
  case 2:
    {float b,h;
    printf("Enter the base of the Triangle:");
    scanf("%f",&b);
    printf("Enter the height of the Triangle:");
    scanf("%f",&h);
    printf("Area of Triangle= %.2f",area=0.5*b*h);
    break;}
  case 3:
    {float l,w;
    printf("Enter the length of the Rectangle:");
    scanf("%f",&l);
    printf("Enter the width of the Rectangle:");
    scanf("%f",&w);
    printf("Area of Rectangle= %.2f",area=l*w);
    break;}
  case 4:
    {float s;
    printf("Enter the side length of the Square:");
    scanf("%f",&s);
    printf("Area of Square= %.2f",area=s*s);
    break;}
  case 5:
    {float b,h;
    printf("Enter the base of the Parallelogram:");
    scanf("%f",&b);
    printf("Enter the height of the Parallelogram:");
    scanf("%f",&h);
    printf("Area of Parallelogram= %.2f",area=b*h);
    break;}
  case 6:
    {float d1,d2;
    printf("Enter the length of diagonal 1 of the Kite:");
    scanf("%f",&d1);
    printf("Enter the length of diagonal 2 of the Kite:");
    scanf("%f",&d2);
    printf("Area of Kite= %.2f",area=d1*d2*0.5);
    break;}
  case 7:
    {float d1,d2;
    printf("Enter the length of 1 diagonal of the Rhombus:");
    scanf("%f",&d1);
    printf("Enter the length of 2 diagonal of the Rhombus:");
    scanf("%f",&d2);
    printf("Area of Rhombus= %.2f",area=d1*d2*0.5);
    break;}
  case 8:
    {float x1,x2,h;
    printf("Enter the length of first parallel side of the Trapezium:");
    scanf("%f",&x1);
    printf("Enter the length of second parallel side of the Trapezium:");
    scanf("%f",&x2);
    printf("Enter the height of the Trapezium:");
    scanf("%f",&h);
    printf("Area of Trapezium=%.2f",area=(x1+x2)*h*0.5);
    break;}
  default: 
    printf("\nInvalid choice!");
    break;
 }
printf("\nDo you want to calculate another area? (y/n): ");
  scanf(" %c", &repeat); 
}
 while (repeat == 'y' || repeat == 'Y');
 printf("\nThank you for using the Area Calculator!\n");
    return 0;
}
