//Write a program to reverse an array with an auxiliary array.
#include<stdio.h>
int main()
{int i,n;
printf("Enter the number of elements of array\n");
 scanf("%d",&n);
 int arr[n],rev[n];
 printf("Enter the array\n");
 for(i=0;i<n;i++)
  scanf("%d",&arr[i]);
 for(i=0;i<n;i++)
   rev[i]=arr[n-1-i];
   printf("Reverse of the array is ");
 for (i=0;i<n;i++)
   printf("%d",rev[i]);
 return 0;
}
