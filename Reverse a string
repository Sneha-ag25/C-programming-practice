//Write a program to reverse a string
#include<stdio.h> 
#include<string.h> 
int main() 
{ int i,j=0,len;
  char sent[100], rev[100];
  printf("Enter a sentence:\n");
  fgets(sent, 100, stdin);
  len=strlen(sent);
  for (i=len-1;i>=0;i--)
     {rev[j]=sent[i];
      j++;}
  rev[j]='\0';
  printf("Reversed string is %s", rev);
  return 0;
}
